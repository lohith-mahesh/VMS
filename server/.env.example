# RRVMS API - environment variables
# Copy to server/.env for local development (never commit the real .env).

# ASP.NET Core environment: Development | Production
ASPNETCORE_ENVIRONMENT=Development

# Port the API binds to on 0.0.0.0. On Render this is injected automatically;
# locally you can leave it unset (launchSettings.json uses http://localhost:5000).
PORT=5000

# PostgreSQL connection string as a URL.
# Supabase example (use the DIRECT connection, not the pooler, so EF migrations can run DDL):
#   postgresql://postgres:YOUR-PASSWORD@db.YOUR-PROJECT-REF.supabase.co:5432/postgres
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# Alternatively, a discrete Npgsql connection string (used only when DATABASE_URL is empty):
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=rrvms;Username=postgres;Password=postgres

# Comma-separated list of allowed frontend origins for CORS.
# Local dev defaults are added automatically in Development:
#   http://localhost:5173, http://localhost:5174
FRONTEND_URL=http://localhost:5173
