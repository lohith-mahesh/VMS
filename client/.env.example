# RRVMS frontend - environment variables
# Copy to client/.env for local development (never commit the real .env).

# Base URL of the RRVMS API (no trailing slash).
# Local development:  http://localhost:5000
# Production/Vercel:  your Render service URL, e.g. https://rrvms-api.onrender.com
# NOTE: Vite bakes this in at BUILD time - set it in Vercel's
# "Environment Variables" BEFORE deploying so it lands in the bundle.
VITE_API_BASE_URL=http://localhost:5000
